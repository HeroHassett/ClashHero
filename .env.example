# Copy to .env and fill in. Never commit .env.

# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: a guild (server) ID to sync slash commands to instantly while developing.
# Leave blank to sync globally (can take up to an hour to show up).
DEV_GUILD_ID=

# Clash of Clans API access. The bot only uses the official developer API; it never signs in
# to a game account. Use ONE of the two options below.
#
# Option A: your developer.clashofclans.com login (email + password for the developer portal,
# NOT your game login). The bot creates an API key for whatever IP it is running on, so it
# keeps working when your IP changes. Keys it creates are named COC_KEY_NAME.
COC_EMAIL=
COC_PASSWORD=
COC_KEY_NAME=clashhero
#
# Option B: paste API key token(s) from developer.clashofclans.com -> My Account -> your key.
# Each key only works from the IP addresses listed on it. Separate several keys with commas.
# If set, this takes priority over option A and nothing is signed in to at all.
COC_API_TOKENS=

# SQLite database file path.
DATABASE_PATH=data/clashhero.db

# Polling intervals. Legend attack inference needs PLAYER_POLL_SECONDS around 60 to separate hits.
CLAN_POLL_SECONDS=60
PLAYER_POLL_SECONDS=60
WAR_POLL_SECONDS=120
RAID_POLL_SECONDS=600

# Optional: any known 28-day season start (Monday 05:00 UTC), if Supercell shifts the cycle.
SEASON_ANCHOR=

LOG_LEVEL=INFO

# Public links shown by /about, e.g. GitHub Pages serving the docs/ folder:
#   https://<user>.github.io/<repo>/terms-of-service and .../privacy-policy
TERMS_URL=
PRIVACY_URL=
SUPPORT_URL=
